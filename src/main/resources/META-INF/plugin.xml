<idea-plugin>
    <id>dev.fatihdogmus.localreview</id>
    <name>Local Review</name>
    <version>0.0.1</version>
    <vendor>Internal</vendor>
    <description><![CDATA[
        <p>Local PR-like review workflow for IntelliJ IDEA.</p>
        <p>Review diffs, add persistent comments, export review data, and hand unresolved comments to coding agents.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>
    <depends>com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <diff.DiffExtension implementation="dev.fatihdogmus.localreview.diff.ReviewDiffExtension"/>
        <fileEditorProvider implementation="dev.fatihdogmus.localreview.editor.ReviewPageEditorProvider"/>
        <postStartupActivity implementation="dev.fatihdogmus.localreview.EnableMcpServerOnStartupActivity"/>
        <mcpServer.mcpToolset implementation="dev.fatihdogmus.localreview.mcp.ReviewMcpToolset"/>
        <notificationGroup id="Local Review" displayType="BALLOON" isLogByDefault="false"/>
        <toolWindow id="Local Review" anchor="left" secondary="true" factoryClass="dev.fatihdogmus.localreview.ReviewStripeToolWindowFactory"/>
    </extensions>

    <actions>
        <action
            id="LocalReview.OpenReviewDialog"
            class="dev.fatihdogmus.localreview.actions.OpenReviewDialogAction"
            text="Open Local Review">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift alt P"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift P"/>
        </action>
        <action
            id="LocalReview.StartReviewFromGitLog"
            class="dev.fatihdogmus.localreview.actions.StartReviewFromGitLogAction"
            text="Create Local Review">
            <add-to-group group-id="Vcs.Log.ContextMenu" anchor="last"/>
            <add-to-group group-id="Vcs.Log.Toolbar.RightCorner" anchor="last"/>
        </action>
        <action
            id="LocalReview.AddComment"
            class="dev.fatihdogmus.localreview.actions.AddReviewCommentAction"
            text="Add Review Comment">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
        <action
            id="LocalReview.OpenReviewedFile"
            class="dev.fatihdogmus.localreview.actions.OpenReviewedFileAction"
            text="Go to File">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
